# ─────────────────────────────────────────────────────────────
#  Punched frontend — public configuration
#
#  Only VITE_* variables reach the browser bundle. Never put a secret here:
#  anything in this file is compiled into the shipped JavaScript.
# ─────────────────────────────────────────────────────────────

# Where the API lives for the browser.
#   • Leave unset (recommended) to use the same-origin `/api` proxy, which keeps
#     the shared session cookie and the tenant header behaving exactly as they
#     do in production.
#   • Set an absolute URL only when the API is on a different origin AND that
#     origin is in the backend's CORS allow-list.
# VITE_API_BASE_URL=https://api.punched.app

# Dev-server proxy target. Used by `npm run dev` only; never shipped.
VITE_API_PROXY_TARGET=http://localhost:5091

# Host → surface resolution. Business storefronts live on
# `{slug}.<root domain>`; the marketing site and the administration console have
# their own hostnames.
VITE_ROOT_DOMAIN=zenbokk.com
VITE_MARKETING_HOST=zenbokk.com
VITE_ADMIN_HOST=admin.zenbokk.com
