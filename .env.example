# ─────────────────────────────────────────────────────────────
#  Punched frontend — PUBLIC configuration only
#
#  Every VITE_* variable is compiled into the JavaScript that ships to the
#  browser. Anything in this file is public: never put a database URL, JWT
#  secret, Redis password, R2 access key, SMTP password, Daraja secret or AI
#  provider key here. `npm run verify:bundle` fails the build if a
#  secret-looking string reaches dist/.
#
#  Copy to `.env.local` for a workstation (gitignored). Deployed builds receive
#  these values as Docker build args (infra/docker-compose.yml), never from a
#  file inside the image.
# ─────────────────────────────────────────────────────────────

# Where the API lives for the browser.
#   • Leave unset (recommended, and the production default) to use the
#     same-origin `/api` path served by Caddy. Nothing has to be rebuilt when the
#     public hostname changes, and no cross-origin request or preflight is made.
#   • Set an absolute URL only when the API is on a different origin AND that
#     origin is in the backend's CORS allow-list.
# VITE_API_BASE_URL=https://api.example.com

# Dev-server proxy target. Used by `npm run dev` / `npm run preview` only; never
# shipped to the browser.
VITE_API_PROXY_TARGET=http://localhost:5091

# Host → surface resolution (public hostnames, never secrets).
# Business storefronts live on `{slug}.<root domain>`; the marketing site and the
# administration console have their own hostnames. The code defaults to
# zenbokk.com when these are unset; local development works with `localhost`,
# `admin.localhost` and `{slug}.localhost` on the same code path.
VITE_ROOT_DOMAIN=localhost
VITE_MARKETING_HOST=localhost
VITE_ADMIN_HOST=admin.localhost
